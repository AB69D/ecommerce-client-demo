# Dependencies
**/node_modules/
**/.pnp
**/.pnp.*
**/.yarn/*

# Build output
**/.next/
**/out/
**/dist/
**/build/

# Env files - NEVER commit secrets
**/.env
**/.env.local
**/.env.*.local

# Vercel
**/.vercel

# Logs
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/.pnpm-debug.log*
**/*.log

# Editor / OS
.DS_Store
**/.DS_Store
**/.idea/
**/.vscode/
**/*.swp

# TypeScript
**/*.tsbuildinfo
**/next-env.d.ts

# Coverage
**/coverage/

# macOS resource forks
**/._*

# Misc
**/*.pem
# Public license-verification key is safe to ship and must be committed —
# it can only verify license signatures, never issue them.
!backend/src/config/license-public-key.pem
**/.passenger/
**/tmp/restart.txt

# Local-only dev scripts (hardcoded test credentials / local Mongo helpers —
# never meant to run anywhere but a developer's machine)
backend/*.local.mjs

# Claude Code local session config
.claude/
